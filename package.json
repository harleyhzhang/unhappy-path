{
  "name": "unhappy-path",
  "private": true,
  "type": "module",
  "scripts": {
    "build-runs": "node bench/run.mjs",
    "grade": "node bench/grade.mjs",
    "report": "python3 bench/analysis.py",
    "calibrate": "node bench/calibrate.mjs",
    "sensitivity": "python3 bench/sensitivity.py",
    "isolation-check": "node bench/isolation-check.mjs",
    "test": "node --test bench/*.test.mjs && python3 -m unittest discover -s bench -p \"test_*.py\" && node bench/calibrate.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "playwright": "^1.49.0"
  }
}
